// Software-managed AM Matmul: A[64,128]bf16 x B[128,256]bf16 -> C[64,256]f32.
//
// K=128 is split into two 64-deep steps: the first step INITs the AM
// accumulator, the second uses `accumulate output` to add the last product,
// convert to the bound f32 L1 output, and release the AM slot automatically.
// A is block-packed [2,64,64] and B [2,64,256] so both K-step inputs are
// contiguous L2 subviews.  The 64x256 f32 AM slot needs exactly 64 KiB.
//
// Generated by examples/generators/generate_boa_am_matmul.py.
// Run: bash examples/run.sh boa-am-matmul

builtin.module {
  tile.program @boa_am_mm(
    %task: !nest.task, %a_l2: !nest.l2_buffer<2x64x64xbf16>,
    %b_l2: !nest.l2_buffer<2x64x256xbf16>, %c_l2: !nest.l2_buffer<64x256xf32>)
        resource_contract = #tile.resources<allowed_profiles = [0, 1, 2],
      tile_l1_spm_bytes_per_context = 147456> {
    %a0_v = tile.subview %a_l2 offsets = [0, 0, 0] sizes = [1, 64, 64] strides = [1, 1, 1]
      : !nest.l2_view<1x64x64xbf16>
    %a1_v = tile.subview %a_l2 offsets = [1, 0, 0] sizes = [1, 64, 64] strides = [1, 1, 1]
      : !nest.l2_view<1x64x64xbf16>
    %b0_v = tile.subview %b_l2 offsets = [0, 0, 0] sizes = [1, 64, 256] strides = [1, 1, 1]
      : !nest.l2_view<1x64x256xbf16>
    %b1_v = tile.subview %b_l2 offsets = [1, 0, 0] sizes = [1, 64, 256] strides = [1, 1, 1]
      : !nest.l2_view<1x64x256xbf16>
    %c_v = tile.subview %c_l2 offsets = [0, 0] sizes = [64, 256] strides = [1, 1]
      : !nest.l2_view<64x256xf32>
    %a0 = tile.alloc shape = [64, 64] dtype = "bf16" alignment = 256 : !tile.l1_buffer<64x64xbf16>
    %a1 = tile.alloc shape = [64, 64] dtype = "bf16" alignment = 256 : !tile.l1_buffer<64x64xbf16>
    %b0 = tile.alloc shape = [64, 256] dtype = "bf16" alignment = 256 : !tile.l1_buffer<64x256xbf16>
    %b1 = tile.alloc shape = [64, 256] dtype = "bf16" alignment = 256 : !tile.l1_buffer<64x256xbf16>
    %out = tile.alloc memory_space = "l1" shape = [64, 256] dtype = "f32" alignment = 256
      : !tile.l1_buffer<64x256xf32>
    %acc = tile.alloc memory_space = "am" logical_slot = 0 output(%out) shape = [64, 256]
      dtype = "f32" alignment = 256 : !tile.am_buffer<64x256xf32>
    %la0 = tile.load.async %a0_v into %a0 : !tile.event<"la0">
    %lb0 = tile.load.async %b0_v into %b0 : !tile.event<"lb0">
    %la1 = tile.load.async %a1_v into %a1 : !tile.event<"la1">
    %lb1 = tile.load.async %b1_v into %b1 : !tile.event<"lb1">
    tile.await %la0, %lb0
    %k0 = tile.boa.async "matmul" ins(%a0, %b0) outs(%out) acc(%acc) m = 64 n = 256 k = 64 seq = 0
      : !tile.event<"k0">
    tile.await %la1, %lb1
    tile.signal input_released(%task)
    tile.await %k0
    %done = tile.boa.async "matmul" ins(%a1, %b1) outs(%out) acc(%acc) m = 64 n = 256 k = 64 seq = 1
      accumulate output : !tile.event<"done">
    tile.await %done
    tile.free %a0
    tile.free %a1
    tile.free %b0
    tile.free %b1
    %stored = tile.store.async %out into %c_v : !tile.event<"stored">
    tile.await %stored
    tile.signal output_ready(%task)
    tile.return
  }
  nest.context @boa_am_ctx(
    %A: !nest.global_memref<2x64x64xbf16>, %B: !nest.global_memref<2x64x256xbf16>,
    %C: !nest.global_memref<64x256xf32>)
    placement = 1
        resource_contract = #nest.context_resources<l2_mode = 0, allowed_profiles = [0, 1, 2],
      logical_tasks = 1, l2_spm_bytes = 147456, requested_contexts_per_tile = 1> {
    %a_blk = nest.subview %A offsets = [0, 0, 0] sizes = [2, 64, 64] strides = [1, 1, 1]
      : !nest.global_view<2x64x64xbf16>
    %b_blk = nest.subview %B offsets = [0, 0, 0] sizes = [2, 64, 256] strides = [1, 1, 1]
      : !nest.global_view<2x64x256xbf16>
    %c_blk = nest.subview %C offsets = [0, 0] sizes = [64, 256] strides = [1, 1]
      : !nest.global_view<64x256xf32>
    %a_l2_1 = nest.alloc slot = "a" role = "in" shape = [2, 64, 64] dtype = "bf16" alignment = 256
      : !nest.l2_buffer<2x64x64xbf16>
    %b_l2_1 = nest.alloc slot = "b" role = "in" shape = [2, 64, 256] dtype = "bf16" alignment = 256
      : !nest.l2_buffer<2x64x256xbf16>
    %c_l2_1 = nest.alloc slot = "c" role = "out" shape = [64, 256] dtype = "f32" alignment = 256
      : !nest.l2_buffer<64x256xf32>
    %a_pref = nest.dma.prefetch.async %a_blk into %a_l2_1 : !nest.event<"a_pref">
    %b_pref = nest.dma.prefetch.async %b_blk into %b_l2_1 : !nest.event<"b_pref">
    %tasks = nest.task.range from = 0 to = 1 : !nest.task_range
    %grid, %read, %ready = nest.dispatch.tasks.async @boa_am_mm l1_mode = 0 context = 0
      tasks(%tasks) globals() bindings(%a_l2_1, %b_l2_1, %c_l2_1) ins(%a_l2_1, %b_l2_1)
      outs(%c_l2_1)
      signal_policy {
        input_released = #nest.aggregate<all_tasks>
        output_ready = #nest.aggregate<all_tasks>
      } depends_on(%a_pref, %b_pref)
      : (!nest.event<"grid">, !nest.event<"read">, !nest.event<"ready">)
    %c_store = nest.dma.store.async %c_l2_1 into %c_blk depends_on(%ready) : !nest.event<"c_store">
    nest.release %a_l2_1 depends_on(%read, %a_pref)
    nest.release %b_l2_1 depends_on(%read, %b_pref)
    nest.release %c_l2_1 depends_on(%c_store)
    nest.await %grid, %c_store
    nest.return
  }
  nexus.program @boa_am_matmul(
    %A_1: !nest.global_memref<2x64x64xbf16>, %B_1: !nest.global_memref<2x64x256xbf16>,
    %C_1: !nest.global_memref<64x256xf32>) {
    %done_1 = nexus.submit_context.async @boa_am_ctx(%A_1, %B_1, %C_1) : !nexus.event<"done">
    nexus.await %done_1
    nexus.return
  }
}
