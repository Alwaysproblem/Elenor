// Software im2col Conv (P03 conv-i8-out): X1x1x3x3xbf16 * W1x1x2x2 -> C[4,1]xi8.
//
// stride 1x1, padding 0x0x0x0, dilation 1x1, tile_k 4; K=4 flattened (ic,kh,kw),
// M=4 rows (batch,oh,ow), output [M,O] row-major.  im2col A is
// materialised by tile.gather.global.async from the X binding (its trailing
// +0 word is the explicit source of every padding element); the typed BOA
// AM chain runs 1 step(s) of depth 4
// mirroring the P03 tile_k block schedule; B is the host-side [K,O] repack
// of the OIHW weights.  No EVU op carries im2col bytes.
//
// Generated by examples/generators/generate_soft_conv.py.
// Run: bash examples/run.sh soft-conv-i8-out

builtin.module {
  tile.program @soft_conv(
    %task: !nest.task, %x_g: !nest.global_view<10xbf16>, %idx_l2: !nest.l2_buffer<16xi32>,
    %b_l2: !nest.l2_buffer<4x1xbf16>, %c_l2: !nest.l2_buffer<4x1xi8>)
        resource_contract = #tile.resources<allowed_profiles = [0, 1, 2, 3],
      tile_l1_spm_bytes_per_context = 16384> {
    %idx0_v = tile.subview %idx_l2 offsets = [0] sizes = [16] strides = [1] : !nest.l2_view<16xi32>
    %b0_v = tile.subview %b_l2 offsets = [0, 0] sizes = [4, 1] strides = [1, 1]
      : !nest.l2_view<4x1xbf16>
    %c_v = tile.subview %c_l2 offsets = [0, 0] sizes = [4, 1] strides = [1, 1]
      : !nest.l2_view<4x1xi8>
    %idx0 = tile.alloc shape = [4, 4] dtype = "i32" alignment = 256 : !tile.l1_buffer<4x4xi32>
    %a0 = tile.alloc shape = [4, 4] dtype = "bf16" alignment = 256 : !tile.l1_buffer<4x4xbf16>
    %b0 = tile.alloc shape = [4, 1] dtype = "bf16" alignment = 256 : !tile.l1_buffer<4x1xbf16>
    %out = tile.alloc memory_space = "l1" shape = [4, 1] dtype = "i8" alignment = 256
      : !tile.l1_buffer<4x1xi8>
    %acc = tile.alloc memory_space = "am" logical_slot = 0 output(%out) shape = [4, 1] dtype = "f32"
      alignment = 256 inv_scale = 0x3f000000 zero_point = 3 : !tile.am_buffer<4x1xf32>
    %li0 = tile.load.async %idx0_v into %idx0 : !tile.event<"li0">
    %lb0 = tile.load.async %b0_v into %b0 : !tile.event<"lb0">
    tile.await %li0, %lb0
    tile.signal input_released(%task)
    %g0 = tile.gather.global.async %x_g indices(%idx0) into %a0
      map = #tile.indexed_map< index_scale = 1 offset = 0 task_stride = 0 repeat = 1 stride = 0 segment = 1>
      window_entries = 16 : !tile.event<"g0">
    tile.await %g0
    %k0 = tile.boa.async "matmul" ins(%a0, %b0) outs(%out) acc(%acc) m = 4 n = 1 k = 4 seq = 0
      output : !tile.event<"k0">
    tile.await %k0
    tile.free %a0
    tile.free %b0
    tile.free %idx0
    %stored = tile.store.async %out into %c_v : !tile.event<"stored">
    tile.await %stored
    tile.signal output_ready(%task)
    tile.return
  }
  nest.context @soft_conv_ctx(
    %X: !nest.global_memref<10xbf16>, %B: !nest.global_memref<4x1xbf16>,
    %IDX: !nest.global_memref<16xi32>, %C: !nest.global_memref<4x1xi8>)
    placement = 1
        resource_contract = #nest.context_resources<l2_mode = 0, allowed_profiles = [0, 1, 2, 3],
      logical_tasks = 1, l2_spm_bytes = 12288, requested_contexts_per_tile = 1> {
    %x_g_1 = nest.subview %X offsets = [0] sizes = [10] strides = [1] : !nest.global_view<10xbf16>
    %b_blk = nest.subview %B offsets = [0, 0] sizes = [4, 1] strides = [1, 1]
      : !nest.global_view<4x1xbf16>
    %idx_blk = nest.subview %IDX offsets = [0] sizes = [16] strides = [1]
      : !nest.global_view<16xi32>
    %c_blk = nest.subview %C offsets = [0, 0] sizes = [4, 1] strides = [1, 1]
      : !nest.global_view<4x1xi8>
    %idx_l2_1 = nest.alloc slot = "idx" role = "in" shape = [16] dtype = "i32" alignment = 256
      : !nest.l2_buffer<16xi32>
    %b_l2_1 = nest.alloc slot = "b" role = "in" shape = [4, 1] dtype = "bf16" alignment = 256
      : !nest.l2_buffer<4x1xbf16>
    %c_l2_1 = nest.alloc slot = "c" role = "out" shape = [4, 1] dtype = "i8" alignment = 256
      : !nest.l2_buffer<4x1xi8>
    %idx_pref = nest.dma.prefetch.async %idx_blk into %idx_l2_1 : !nest.event<"idx_pref">
    %b_pref = nest.dma.prefetch.async %b_blk into %b_l2_1 : !nest.event<"b_pref">
    %tasks = nest.task.range from = 0 to = 1 : !nest.task_range
    %grid, %read, %ready = nest.dispatch.tasks.async @soft_conv l1_mode = 0 context = 0
      tasks(%tasks) globals(%x_g_1) bindings(%idx_l2_1, %b_l2_1, %c_l2_1) ins(%idx_l2_1, %b_l2_1)
      outs(%c_l2_1)
      signal_policy {
        input_released = #nest.aggregate<all_tasks>
        output_ready = #nest.aggregate<all_tasks>
      } depends_on(%idx_pref, %b_pref)
      : (!nest.event<"grid">, !nest.event<"read">, !nest.event<"ready">)
    %c_store = nest.dma.store.async %c_l2_1 into %c_blk depends_on(%ready) : !nest.event<"c_store">
    nest.release %idx_l2_1 depends_on(%read, %idx_pref)
    nest.release %b_l2_1 depends_on(%read, %b_pref)
    nest.release %c_l2_1 depends_on(%c_store)
    nest.await %grid, %c_store
    nest.return
  }
  nexus.program @soft_conv_entry(
    %X_1: !nest.global_memref<10xbf16>, %B_1: !nest.global_memref<4x1xbf16>,
    %IDX_1: !nest.global_memref<16xi32>, %C_1: !nest.global_memref<4x1xi8>) {
    %done = nexus.submit_context.async @soft_conv_ctx(%X_1, %B_1, %IDX_1, %C_1)
      : !nexus.event<"done">
    nexus.await %done
    nexus.return
  }
}
