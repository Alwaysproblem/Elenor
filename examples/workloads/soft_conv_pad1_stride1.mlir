      map = #tile.indexed_map< index_scale = 1 offset = 0 task_stride = 0 repeat = 1 stride = 0 segment = 1>
      window_entries = 16 : !tile.event<"g0">
    tile.await %g0
    %k0 = tile.boa.async "matmul" ins(%a0, %b0) outs(%out) acc(%acc) m = 16 n = 2 k = 8 seq = 0
      : !tile.event<"k0">
    tile.await %k0
    tile.free %a0
    tile.free %b0
    tile.free %idx0
    %g1 = tile.gather.global.async %x_g indices(%idx1) into %a1
      map = #tile.indexed_map< index_scale = 1 offset = 0 task_stride = 0 repeat = 1 stride = 0 segment = 1>
