-"${VERILATOR_BIN}" "\${args[@]}"
+# ChiselSim separates headers into support-artifacts, beside primary-sources.
+# Include that directory and load macro-only headers before their SV consumers.
+headers=()
+native_warning_policy=()
+for arg in "\${args[@]}"; do
+  if [[ "\${arg}" == +incdir+* ]]; then
+    IFS='+' read -r -a include_dirs <<< "\${arg#+incdir+}"
+    for dir in "\${include_dirs[@]}"; do
+      support="\${dir%/*}/support-artifacts"
+      if [[ -d "\${support}" ]]; then
+        headers+=("+incdir+\${support}")
+        for header in registers.svh rvv_backend_config.svh; do
+          if [[ -f "\${support}/\${header}" ]]; then
+            headers+=("\${support}/\${header}")
+            # Match the warnings-visible policy of fpga/coralnpu_soc.core.
+            # Chisel-only cases retain the default fatal-warning policy.
+            if [[ "\${header}" == registers.svh ]]; then
+              native_warning_policy=("-Wno-fatal")
+            fi
+          fi
+        done
+      fi
+    done
+  fi
+done
+"${VERILATOR_BIN}" "\${native_warning_policy[@]}" "\${headers[@]}" "\${args[@]}"
 EOF
 chmod +x "${WRAPPER_DIR}/verilator"
 
