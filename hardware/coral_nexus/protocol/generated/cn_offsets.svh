function automatic string cn_err_name(input int e);
  case (e)
    0: cn_err_name = "OK";
    1: cn_err_name = "TRUNCATED";
    2: cn_err_name = "TRAILING";
    3: cn_err_name = "UNKNOWN_MSG";
    4: cn_err_name = "WRONG_PORT";
    5: cn_err_name = "LENGTH_MISMATCH";
    6: cn_err_name = "RESERVED";
    7: cn_err_name = "ENUM_RANGE";
    8: cn_err_name = "BOOL_RANGE";
    9: cn_err_name = "BITSET_RANGE";
    10: cn_err_name = "CONDITION";
    11: cn_err_name = "TRANSPORT_REPLAY";
    12: cn_err_name = "INCOMPLETE";
    13: cn_err_name = "STALE_GENERATION";
    14: cn_err_name = "ACK_MISMATCH";
    15: cn_err_name = "DUPLICATE_STAGE";
    16: cn_err_name = "CAPACITY";
    default: cn_err_name = "?";
  endcase
endfunction
