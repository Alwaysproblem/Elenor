{
  "name": "coral-nexus-builder",
  "image": "coral-nexus-builder:c002",
  "remoteUser": "builder",
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "TZ": "UTC"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=coral-nexus-bazel-cache,target=/home/builder/.cache/bazel,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "postCreateCommand": "bazel --version && clang --version | head -1"
}
